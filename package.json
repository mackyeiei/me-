{
  "name": "offline-survival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first survival PWA: map, compass, guide, knots, plan, tools.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/size-report.mjs",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name offline-survival"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "marked": "^18.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
